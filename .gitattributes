# Set default behavior to automatically normalize line endings
* text=auto

# Cargo.toml files should always use LF
Cargo.toml text eol=lf

# Lock files should always use LF
Cargo.lock text eol=lf

# Rust source files should use LF
*.rs text eol=lf

# Markdown files should use LF
*.md text eol=lf

# TOML config files should use LF
*.toml text eol=lf